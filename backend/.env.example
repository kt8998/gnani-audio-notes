# Copy to .env and fill in. Never commit .env.

# PostgreSQL (Railway: use DATABASE_PUBLIC_URL locally, DATABASE_URL inside Railway)
DATABASE_URL=

# Gnani Speech-to-Text (https://docs.gnani.ai/api/STT/speech-to-text)
GNANI_API_KEY=
GNANI_STT_URL=https://api.vachana.ai/stt/v3

# Object storage: Supabase Storage via its S3-compatible API.
# Project Settings > Storage > S3 connection (enable it, then create an access key).
# The keys have full access to all buckets: server-side only, never in the frontend.
S3_ENDPOINT_URL=https://<project_ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project region, e.g. ap-south-1>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=audio-notes

# LLM summarization (Google Gemini, free tier). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Processing
MAX_UPLOAD_MB=50  # Supabase free plan: 50 MB per file
CHUNK_SECONDS=25
TRANSCRIBE_CONCURRENCY=3

# Local Windows dev only: verify TLS against the Windows certificate store
# (needed when antivirus such as Avast intercepts HTTPS). Leave false in production.
USE_OS_TRUSTSTORE=false
